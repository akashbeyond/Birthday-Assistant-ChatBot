# Copy this file to .env and fill in your key. .env is git-ignored. NEVER commit a real key.
# --- Option A: Google Gemini (free tier) ---
OPENAI_API_KEY="enter your api key here"
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL="Choose and name your model here"
LLM_TIMEOUT="Timeout in seconds for LLM calls"
LLM_REPLY=0
# --- Option B: OpenAI (paid): replace the Gemini lines above with ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini